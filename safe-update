#!/usr/bin/env bash
set -euo pipefail

# ANSI Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
CYAN='\033[1;36m'
PINK='\033[1;35m'
BOLD='\033[1m'
NC='\033[0m'

# Prints "<binary> <built-against Qt> <installed Qt>" and succeeds if Quickshell
# was built against a different Qt than the one installed now.
quickshell_qt_mismatch() {
    local bin built installed
    bin=$(command -v quickshell || command -v qs || true)
    [[ -n "$bin" ]] && command -v strings &>/dev/null || return 1
    built=$(strings -n 5 "$bin" | grep -m1 -xE '6\.[0-9]+\.[0-9]+' || true)
    installed=$(pacman -Q qt6-base 2>/dev/null | awk '{print $2}' | cut -d- -f1)
    [[ -n "$built" && -n "$installed" && "$built" != "$installed" ]] || return 1
    echo "$bin $built $installed"
}

# ─────────────────────────────────────────────────────────────────
# Welcome Banner with Full Cat ASCII Art
# ─────────────────────────────────────────────────────────────────
echo -ne "${PINK}"
cat << 'EOF'
        /\_____/\
       /  o   o  \
      ( ==  ^  == )
       )         (
      (           )
     ( (  )   (  ) )
    (__(__)___(__)__)
EOF
echo -ne "${NC}"
echo -e "${CYAN}┌─────────────────────────────────────────┐${NC}"
echo -e "${CYAN}│  🐾 Arch Linux Safe Update Assistant 🐾 │${NC}"
echo -e "${CYAN}│   Guarding your rice, dots & packages!  │${NC}"
echo -e "${CYAN}└─────────────────────────────────────────┘${NC}"
echo ""

# ─────────────────────────────────────────────────────────────────
# 1. Back up active Rice & Dotfiles (hyprland, matugen, illogical, etc.)
# ─────────────────────────────────────────────────────────────────
echo -ne "${PINK}"
cat << 'EOF'
       /\_/\
      ( o.o )
      /|   |\
     (_|   |_)
EOF
echo -e "${BLUE}📦 [Step 1/8]${NC} Packing up your rice, matugen & configs..."
if [[ -x "${HOME}/.local/bin/rice-backup" ]]; then
    "${HOME}/.local/bin/rice-backup"
else
    echo -e "  ${YELLOW}Notice: rice-backup script not found, proceeding...${NC}"
fi
echo ""

# ─────────────────────────────────────────────────────────────────
# 2. Check for Currently Broken AUR Packages (Pre-check)
# ─────────────────────────────────────────────────────────────────
echo -ne "${PINK}"
cat << 'EOF'
       /\_/\
      ( •.• )
      /|   |\
     (_|   |_)
EOF
echo -e "${BLUE}🔍 [Step 2/8]${NC} Sniffing for broken AUR shared libraries..."
BROKEN_BEFORE=$(checkrebuild 2>/dev/null || true)
if [ -n "$BROKEN_BEFORE" ]; then
    echo -e "${RED}⚠ Found existing broken packages before update:${NC}"
    echo "$BROKEN_BEFORE" | sed 's/^/    /'
    echo ""
else
    echo -e "  ${GREEN}✓ No existing broken AUR dependencies detected! Purr-fect.${NC}"
fi
echo ""

# ─────────────────────────────────────────────────────────────────
# 3. Preview Pending Updates
# ─────────────────────────────────────────────────────────────────
echo -ne "${PINK}"
cat << 'EOF'
       /\_/\
      ( ◕.◕ )
      /|   |\~
     (_|   |_)
EOF
echo -e "${BLUE}📜 [Step 3/8]${NC} Reading the pending updates scroll..."
PENDING_REPO=$(checkupdates 2>/dev/null || true)
PENDING_AUR=$(yay -Qua 2>/dev/null || true)

if [ -z "$PENDING_REPO" ] && [ -z "$PENDING_AUR" ]; then
    echo -e "  ${GREEN}✓ Your system is completely up to date! (=^･ω･^=)${NC}"
    if quickshell_qt_mismatch >/dev/null; then
        echo -e "  ${YELLOW}...but Quickshell still needs rebuilding for the new Qt. Continuing!${NC}"
    else
        echo -ne "${PINK}"
        cat << 'EOF'
       /\_/\
      ( -.- ) Zzz... Taking a cat nap then... Exiting!
     (__(__)_)
EOF
        echo -e "${NC}"
        exit 0
    fi
else
    if [ -n "$PENDING_REPO" ]; then
        REPO_COUNT=$(echo "$PENDING_REPO" | wc -l)
        echo -e "  ${BOLD}Official Repositories (${REPO_COUNT} packages):${NC}"
        echo "$PENDING_REPO" | sed 's/^/    /'
    fi
    if [ -n "$PENDING_AUR" ]; then
        AUR_COUNT=$(echo "$PENDING_AUR" | wc -l)
        echo -e "  ${BOLD}AUR Packages (${AUR_COUNT} packages):${NC}"
        echo "$PENDING_AUR" | sed 's/^/    /'
    fi
fi
echo ""

# ─────────────────────────────────────────────────────────────────
# 4. Take Timeshift Btrfs Snapshot (Root + Home included)
# ─────────────────────────────────────────────────────────────────
echo -ne "${PINK}"
cat << 'EOF'
       /\_/\
      ( •̀.•́ )
      /|   |\~
     (_|   |_)
EOF
echo -e "${BLUE}🛡️ [Step 4/8]${NC} Casting Btrfs snapshot shield over root & @home..."

# Ask for the sudo password once, then keep the credential cache warm in the
# background so timeshift, yay/pacman and the fprintd restart never re-prompt.
sudo -v
while true; do sudo -n true; sleep 50; kill -0 "$$" || exit; done 2>/dev/null &
SUDO_KEEPALIVE_PID=$!
trap 'kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true' EXIT

SNAP_COMMENT="pre-update $(date '+%Y-%m-%d %H:%M')"
sudo timeshift --create --comments "$SNAP_COMMENT" --tags O
echo -e "${GREEN}✓ Snapshot created successfully!${NC}"
echo -e "  ${CYAN}System files, @home, matugen themes & rice configs are safely shielded.${NC}"
echo ""

# ─────────────────────────────────────────────────────────────────
# 5. Execute System & AUR Upgrade
# ─────────────────────────────────────────────────────────────────
echo -ne "${PINK}"
cat << 'EOF'
       /\_/\
      ( ^.^ )
      /|   |\💻
     (_|   |_)
EOF
echo -e "${BLUE}💻 [Step 5/8]${NC} *tippity tappity* Upgrading packages with yay..."
yay -Syu --sudoloop --noconfirm --answerclean None --answerdiff None --answeredit None
echo ""

# ─────────────────────────────────────────────────────────────────
# 6. Post-update: Rebuild Detector Check & Rice Health Check
# ─────────────────────────────────────────────────────────────────
echo -ne "${PINK}"
cat << 'EOF'
       /\_/\
      ( ˘ω˘ )
      /|   |\
     (_|   |_)
EOF
echo -e "${BLUE}🩺 [Step 6/8]${NC} Checking post-update library health & rice vitals..."
BROKEN_AFTER=$(checkrebuild 2>/dev/null || true)

if [ -n "$BROKEN_AFTER" ]; then
    echo -e "${RED}${BOLD}⚠ The following AUR packages were linked against libraries that were just updated:${NC}"
    echo "$BROKEN_AFTER" | sed 's/^/    /'
    echo ""
    REBUILD_PKGS=$(echo "$BROKEN_AFTER" | awk '{print $2}' | sort -u | tr '\n' ' ')
    echo -e "${CYAN}Run the following command to rebuild them:${NC}"
    echo -e "  ${BOLD}yay -S --rebuild $REBUILD_PKGS${NC}"
else
    echo -e "  ${GREEN}✓ All AUR packages are fully compatible with updated libraries!${NC}"
fi

# Run rice health check if available
if [[ -x "${HOME}/.local/bin/rice-healthcheck" ]]; then
    echo ""
    "${HOME}/.local/bin/rice-healthcheck"
fi
echo ""

# ─────────────────────────────────────────────────────────────────
# 7. Post-update: Rebuild Quickshell if Qt moved under it
# ─────────────────────────────────────────────────────────────────
# Quickshell uses Qt private APIs, so it must be rebuilt after every Qt
# version bump. Packages from illogical-impulse's local PKGBUILDs aren't in
# the AUR, so yay and checkrebuild never catch them.
echo -ne "${PINK}"
cat << 'EOF'
       /\_/\
      ( o.O )
      /|   |\🔧
     (_|   |_)
EOF
echo -e "${BLUE}🔧 [Step 7/8]${NC} Checking Quickshell against the installed Qt..."
if ! QS_MISMATCH=$(quickshell_qt_mismatch); then
    echo -e "  ${GREEN}✓ Quickshell is not installed or already matches the installed Qt!${NC}"
else
    read -r QS_BIN QS_QT SYS_QT <<< "$QS_MISMATCH"
    QS_PKG=$(pacman -Qqo "$QS_BIN" 2>/dev/null || true)
    if [[ -z "$QS_PKG" ]] || ! pacman -Qqm "$QS_PKG" &>/dev/null; then
        echo -e "  ${YELLOW}⚠ Quickshell was built against Qt ${QS_QT} but Qt ${SYS_QT} is installed.${NC}"
        echo -e "  ${YELLOW}  It comes from the official repos or no package; wait for a repo rebuild.${NC}"
    else
        echo -e "  ${YELLOW}Quickshell was built against Qt ${QS_QT}, system has Qt ${SYS_QT}. Rebuilding ${QS_PKG}...${NC}"
        II_PKGBUILD_DIR="${HOME}/.cache/dots-hyprland/sdata/dist-arch/${QS_PKG}"
        if [[ -f "${II_PKGBUILD_DIR}/PKGBUILD" ]]; then
            REBUILD_CMD=(bash -c 'cd "$1" && makepkg -si --noconfirm --force --cleanbuild --clean' _ "$II_PKGBUILD_DIR")
            MANUAL_CMD="cd ${II_PKGBUILD_DIR} && makepkg -si --force --cleanbuild"
        else
            REBUILD_CMD=(yay -S --rebuild --noconfirm --answerclean None --answerdiff None --answeredit None "$QS_PKG")
            MANUAL_CMD="yay -S --rebuild ${QS_PKG}"
        fi
        if "${REBUILD_CMD[@]}"; then
            echo -e "  ${GREEN}✓ ${QS_PKG} rebuilt against Qt ${SYS_QT}!${NC}"
            echo -e "  ${CYAN}Restart your shell to load it (e.g. log out and back in).${NC}"
        else
            echo -e "  ${RED}⚠ Rebuilding ${QS_PKG} failed. Run manually:${NC}"
            echo -e "    ${BOLD}${MANUAL_CMD}${NC}"
        fi
    fi
fi
echo ""

# ─────────────────────────────────────────────────────────────────
# 8. Post-update: Restart fingerprint sensor
# ─────────────────────────────────────────────────────────────────
echo -ne "${PINK}"
cat << 'EOF'
       /\_/\
      ( ˶ᵔ ᵕ ᵔ˶ )
      /|   |\
     (_|   |_)
EOF
echo -e "${BLUE}🔏 [Step 8/8]${NC} Refreshing fingerprint sensor..."
if command -v fprintd-list &>/dev/null; then
    sudo systemctl restart fprintd.service 2>/dev/null && \
        echo -e "  ${GREEN}✓ Fingerprint service restarted!${NC}" || \
        echo -e "  ${YELLOW}Notice: Could not restart fprintd${NC}"
    FPRINT_STATUS=$(fprintd-list "$(whoami)" 2>/dev/null | grep "right-index-finger" || true)
    if [ -n "$FPRINT_STATUS" ]; then
        echo -e "  ${GREEN}✓ Fingerprint enrolled & sensor healthy 🐾${NC}"
    else
        echo -e "  ${YELLOW}⚠ No fingerprint enrolled. Run: fprintd-enroll${NC}"
    fi
else
    echo -e "  ${YELLOW}Notice: fprintd not installed, skipping...${NC}"
fi

echo ""
echo -e "${CYAN}${BOLD}════════════════════════════════════════════════════════════${NC}"
echo -ne "${PINK}"
cat << 'EOF'
        /\_____/\
       /  ^   ^  \
      ( ==  w  == )
       )         (
      (           )
     ( (  )   (  ) )
    (__(__)___(__)__)
EOF
echo -e "${GREEN}${BOLD}✨ Purr-fect! Update completed safely! ✨${NC}"
echo -e "${CYAN}Your system is fresh, rice is cozy, and snapshots are ready!${NC}"
echo ""
echo -e "${CYAN}Rollback instructions (if anything ever breaks):${NC}"
echo -e "  - Full system rollback:    ${BOLD}sudo timeshift --restore${NC}"
echo -e "  - Rice config rollback:    ${BOLD}~/.local/bin/rice-restore${NC}"
echo -e "${CYAN}${BOLD}════════════════════════════════════════════════════════════${NC}"
